{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug (ST-Link)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "stlink",
      // 路径全部来自 settings.json 中的 stm32.cltPath，不依赖进程环境变量
      "stlinkPath": "${config:stm32.cltPath}/STLink-gdb-server/bin/ST-LINK_gdbserver",
      "device": "STM32F407ZG",
      "svdFile": "${config:stm32.cltPath}/STMicroelectronics_CMSIS_SVD/STM32F407.svd",
      "executable": "${workspaceFolder}/esxp1302_stm32f407/build/Debug/esxp1302_stm32f407.elf",
      "runToEntryPoint": "main",
      "stm32cubeprogrammer": "${config:stm32.cltPath}/STM32CubeProgrammer/bin",
      "preLaunchTask": "Build",
      "showDevDebugOutput": "parsed",
      "swoConfig": {
        "enabled": false
      },
      "toolchainPrefix": "arm-none-eabi",
      "registerUseNaturalFormat": true,
      "variableUseNaturalFormat": true
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": true,
      "cwd": "d:/Projects/Espidf/esxp1302_on_esp32s3/esxp1302_stm32f407/Core/Src",
      "program": "d:/Projects/Espidf/esxp1302_on_esp32s3/esxp1302_stm32f407/Core/Src/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}