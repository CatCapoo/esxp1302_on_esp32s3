{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug (ST-Link)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "stlink",
      "stlinkPath": "${env:STM32_CLT_PATH}/STLink-gdb-server/bin/ST-LINK_gdbserver",
      "armToolchainPath": "${env:STM32_CLT_PATH}/GNU-tools-for-STM32/bin",
      "device": "STM32F407ZG",
      "svdFile": "${env:STM32_CLT_PATH}/STMicroelectronics_CMSIS_SVD/STM32F407.svd",
      "executable": "${workspaceFolder}/esxp1302_stm32f407/build/Debug/esxp1302_stm32f407.elf",
      "runToEntryPoint": "main",
      "stm32cubeprogrammer": "${env:STM32_CLT_PATH}/STM32CubeProgrammer/bin",
      "preLaunchTask": "Build",
      "showDevDebugOutput": "raw",
      "swoConfig": {
        "enabled": false
      }
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": true,
      "cwd": "d:/Projects/Espidf/esxp1302_on_esp32s3/esxp1302_stm32f407/Core/Src",
      "program": "d:/Projects/Espidf/esxp1302_on_esp32s3/esxp1302_stm32f407/Core/Src/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}